# =============================================================================
# FRONTEND .env — Firebase client config for the Expo app
# =============================================================================
# Get these from Firebase Console > Project Settings > General > Your apps
# Copy this file to .env and fill in real values.

FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Backend server URL — change this if running on a physical phone
# For simulator/web:        http://localhost:3000
# For physical phone:       http://YOUR_LAN_IP:3000  (e.g. http://192.168.1.5:3000)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000


