# =============================================================================
# BACKEND .env — Server config
# =============================================================================
# Copy this file to server/.env and fill in real values.

PORT=3000

# CORS — allowed origins for the frontend app
# Add your Expo origin here if different from defaults
# Defaults include: exp://localhost:19000, http://localhost:19006, http://localhost:8081
CORS_ALLOWED_ORIGINS=exp://localhost:19000,http://localhost:19006,http://localhost:8081

# -----------------------------------------------------------------------------
# Firebase Admin (for verifying auth tokens from the frontend)
# -----------------------------------------------------------------------------
# Get from Firebase Console > Project Settings > Service accounts > Generate new private key
#
# IMPORTANT: If you don't need Firebase auth (just testing AI features locally),
# set ALLOW_DEV_AUTH_BYPASS=true below and leave these as placeholders.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AI Provider (at least ONE is required for AI colleagues to work)
# -----------------------------------------------------------------------------

# Option 1: MuleRun (preferred)
# Get your key from: https://mulerun.com/creator/studio > API Keys tab
# API docs: https://mulerun.com/docs/api-reference-internal-1585752d51de1232/quickstart
MULERUN_API_KEY=your-mulerun-api-key-here
MULERUN_API_BASE=https://api.mulerun.com/v1

# Option 2: OpenAI (fallback if MuleRun is not set)
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Job Search APIs (optional — for career insights / market data)
# -----------------------------------------------------------------------------
# At least one provider is needed for career insights.
# If none are configured, career insights will return empty data gracefully.

# Adzuna (recommended — https://developer.adzuna.com/)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Jooble (alternative — https://jooble.org/api/)
JOOBLE_API_KEY=your-jooble-api-key

# USAJobs (for US government jobs — https://developer.usajobs.gov/)
USAJOBS_API_KEY=your-usajobs-api-key
USAJOBS_USER_EMAIL=your-contact@example.com

# -----------------------------------------------------------------------------
# Development options
# -----------------------------------------------------------------------------
# Set to "development" for local dev (enables dev auth bypass, relaxed CORS)
NODE_ENV=development

# Set to "true" to skip Firebase auth verification in development.
# This lets you test AI features without configuring Firebase on both client and server.
# WARNING: Never enable this in production!
ALLOW_DEV_AUTH_BYPASS=true
